<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>LernCheck</display-name>

    <!-- ===================== FILTER ===================== -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.example.quiz.filter.AuthFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/teacher/*</url-pattern>
    </filter-mapping>

    <!-- ===================== TEACHER SERVLETS ===================== -->

    <servlet>
        <servlet-name>TeacherLoginServlet</servlet-name>
        <servlet-class>com.example.quiz.servlet.teacher.TeacherLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherLoginServlet</servlet-name>
        <url-pattern>/teacher/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TeacherRegisterServlet</servlet-name>
        <servlet-class>com.example.quiz.servlet.teacher.TeacherRegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherRegisterServlet</servlet-name>
        <url-pattern>/teacher/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TeacherLogoutServlet</servlet-name>
        <servlet-class>com.example.quiz.servlet.teacher.TeacherLogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherLogoutServlet</servlet-name>
        <url-pattern>/teacher/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TeacherDashboardServlet</servlet-name>
        <servlet-class>com.example.quiz.servlet.teacher.TeacherDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherDashboardServlet</servlet-name>
        <url-pattern>/teacher/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TeacherCreateClassServlet</servlet-name>
        <servlet-class>com.example.quiz.servlet.teacher.TeacherCreateClassServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherCreateClassServlet</servlet-name>
        <url-pattern>/teacher/class/create</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TeacherClassQuizzesServlet</servlet-name>
        <servlet-class>com.example.quiz.servlet.teacher.TeacherClassQuizzesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherClassQuizzesServlet</servlet-name>
        <url-pattern>/teacher/class</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TeacherQuizBuilderServlet</servlet-name>
        <servlet-class>com.example.quiz.servlet.teacher.TeacherQuizBuilderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherQuizBuilderServlet</servlet-name>
        <url-pattern>/teacher/quiz/builder</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TeacherTemplateSelectServlet</servlet-name>
        <servlet-class>com.example.quiz.servlet.teacher.TeacherTemplateSelectServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherTemplateSelectServlet</servlet-name>
        <url-pattern>/teacher/templates</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TeacherStartQuizServlet</servlet-name>
        <servlet-class>com.example.quiz.servlet.teacher.TeacherStartQuizServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherStartQuizServlet</servlet-name>
        <url-pattern>/teacher/quiz/start</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TeacherQuizResultsServlet</servlet-name>
        <servlet-class>com.example.quiz.servlet.teacher.TeacherQuizResultsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherQuizResultsServlet</servlet-name>
        <url-pattern>/teacher/quiz/results</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TeacherQuizFeedbackServlet</servlet-name>
        <servlet-class>com.example.quiz.servlet.teacher.TeacherQuizFeedbackServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherQuizFeedbackServlet</servlet-name>
        <url-pattern>/teacher/quiz/feedback</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TeacherRestartQuizServlet</servlet-name>
        <servlet-class>com.example.quiz.servlet.teacher.TeacherRestartQuizServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeacherRestartQuizServlet</servlet-name>
        <url-pattern>/teacher/quiz/restart</url-pattern>
    </servlet-mapping>

    <!-- ===================== STUDENT SERVLETS ===================== -->

    <servlet>
        <servlet-name>StudentJoinServlet</servlet-name>
        <servlet-class>com.example.quiz.servlet.student.StudentJoinServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentJoinServlet</servlet-name>
        <url-pattern>/student/join</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentTakeQuizServlet</servlet-name>
        <servlet-class>com.example.quiz.servlet.student.StudentTakeQuizServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentTakeQuizServlet</servlet-name>
        <url-pattern>/student/take</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentSubmitServlet</servlet-name>
        <servlet-class>com.example.quiz.servlet.student.StudentSubmitServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentSubmitServlet</servlet-name>
        <url-pattern>/student/submit</url-pattern>
    </servlet-mapping>

    <!-- Default welcome -->
    <welcome-file-list>
        <welcome-file>teacher/login.jsp</welcome-file>
    </welcome-file-list>

</web-app>